{
  "name": "ideas-roundtable",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "start:remote": "node --env-file-if-exists=.env remote-worker.mjs",
    "start:service": "node --env-file-if-exists=.env scripts/remote-service.mjs",
    "setup:tunnel": "node scripts/tunnel-tools.mjs",
    "service:install": "node scripts/remote-daemon.mjs install",
    "service:status": "node scripts/remote-daemon.mjs status",
    "service:remove": "node scripts/remote-daemon.mjs remove",
    "remote:password": "node scripts/remote-password.mjs",
    "test": "node --test tests/*.test.mjs",
    "setup:local": "node scripts/local-tools.mjs install",
    "doctor": "node --env-file-if-exists=.env scripts/local-tools.mjs doctor",
    "login:gpt": "node scripts/local-tools.mjs gpt",
    "login:claude": "node scripts/local-tools.mjs claude",
    "login:gemini": "node scripts/local-tools.mjs gemini",
    "build:static": "node scripts/build-static.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.1"
  }
}
