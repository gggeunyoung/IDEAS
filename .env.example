# Copy to .env locally. Never paste API keys into chat or commit them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3030

# 구독 CLI 설정. 비워두면 설치한 CLI의 기본 모델을 사용합니다.
LOCAL_GPT_MODEL=
LOCAL_CLAUDE_MODEL=
LOCAL_GEMINI_MODEL=
# 자료 선택에 사용할 프로젝트 폴더. 비워두면 IDEAS 폴더입니다.
IDEAS_PROJECT_ROOT=
# CLI 경로를 직접 지정할 때만 설정합니다.
LOCAL_CODEX_BIN=
LOCAL_CLAUDE_BIN=
LOCAL_GEMINI_BIN=
