# Copy to .env locally. Never paste API keys into chat or commit them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3030

# 구독 CLI 설정. 비워도 GPT 6.1 Sol / Claude Opus 5.5를 명시해 사용합니다.
LOCAL_GPT_MODEL=gpt-6.1-sol
LOCAL_CLAUDE_MODEL=claude-opus-5-5
LOCAL_GEMINI_MODEL=
# 자료 선택에 사용할 프로젝트 폴더. 비워두면 IDEAS 폴더입니다.
IDEAS_PROJECT_ROOT=
# CLI 경로를 직접 지정할 때만 설정합니다.
LOCAL_CODEX_BIN=
LOCAL_CLAUDE_BIN=
LOCAL_GEMINI_BIN=

# 구독 CLI 사고 수준: low / medium / high / xhigh / max
LOCAL_GPT_REASONING_EFFORT=high
LOCAL_CLAUDE_REASONING_EFFORT=high
